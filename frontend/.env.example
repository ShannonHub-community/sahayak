# Sahayak Frontend — Environment Variables
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and will never be committed.

# Public URL for client-side browser requests to the backend.
# Set this to your deployed backend URL on Render (or your ngrok tunnel for local dev).
# Leave empty to use Next.js proxy rewrites via BACKEND_INTERNAL_URL (recommended for local dev).
NEXT_PUBLIC_API_URL=https://sahayak-backend-nu6f.onrender.com

# Internal URL used by Next.js server-side API rewrites (next.config.ts).
# Proxies /api/* routes to this backend URL at build/request time.
BACKEND_INTERNAL_URL=https://sahayak-backend-nu6f.onrender.com
