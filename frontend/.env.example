# Sahayak Frontend Environment Variables
# If backend is running on an ngrok tunnel (or deployed externally), specify its full reachable URL here:
# Example: NEXT_PUBLIC_API_URL=https://sahayak-backend.ngrok-free.dev
#
# If running backend locally alongside frontend, leave empty to use Next.js proxy rewrites to localhost:8000.
NEXT_PUBLIC_API_URL=
BACKEND_INTERNAL_URL=http://127.0.0.1:8000
