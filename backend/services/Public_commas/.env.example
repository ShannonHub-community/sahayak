# ============================================================
# news_report service - environment variables
# Copy this file to .env and fill in real values before running.
# Vars marked REQUIRED will make the app refuse to start if missing.
# ============================================================

# --- Database (Supabase Postgres) --- REQUIRED
DATABASE_URL=postgresql+asyncpg://postgres:<password>@<project-ref>.pooler.supabase.com:6543/postgres

# --- Shared AI model (same one used by the AI Decision System) --- REQUIRED
AI_MODEL_API_URL=
AI_MODEL_API_KEY=
AI_MODEL_NAME=claude-sonnet-4-6
AI_MODEL_TIMEOUT_S=30
AI_MODEL_MAX_RETRIES=3

# --- SMS Gateway (Sub-Tab 1 broadcast) --- REQUIRED
SMS_GATEWAY_URL=
SMS_GATEWAY_API_KEY=
SMS_GATEWAY_TIMEOUT_S=15
SMS_GATEWAY_MAX_RETRIES=3

