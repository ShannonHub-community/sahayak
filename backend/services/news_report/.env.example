# Config for backend/services/news_report (Live Updates: translation + TTS)
#
# Copy this file to .env (or merge these keys into your project's existing
# .env) and fill in real values. Never commit the real .env file.

# Required for translation (POST /api/comms/translate) and text-to-speech
# (POST /api/comms/tts) to actually work. Without it, translate falls back
# to returning original English text, and TTS returns a 502.
SARVAM_API_KEY=

# Optional overrides - defaults shown below.
SARVAM_API_BASE_URL=https://api.sarvam.ai
SARVAM_TIMEOUT_SECONDS=15
SARVAM_TTS_SPEAKER=meera
